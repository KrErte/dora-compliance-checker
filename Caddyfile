# DoraAudit.eu - Caddy Configuration
# Automatic HTTPS for all domains

# Main site
doraaudit.eu, www.doraaudit.eu {
    # API requests -> Backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # All other requests -> Frontend
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://app.lemonsqueezy.com https://umami.doraaudit.eu; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.lemonsqueezy.com https://umami.doraaudit.eu https://ipapi.co; frame-src https://app.lemonsqueezy.com; object-src 'none'; base-uri 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# Umami Analytics subdomain
umami.doraaudit.eu {
    reverse_proxy umami:3000

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
