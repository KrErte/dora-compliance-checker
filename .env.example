# DORA Compliance Checker - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# Claude API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# JWT Secret - Generate a secure 256-bit key
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-256-bit-secret-key-here

# PostgreSQL Database Credentials
POSTGRES_USER=dorauser
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=doradb

# ===========================================
# OPTIONAL - Have sensible defaults
# ===========================================

# Guardian Contract Monitoring
GUARDIAN_FEED_ENABLED=false
GUARDIAN_FEED_CRON=0 0 6 * * *

# Resend Email API (for contact form notifications)
RESEND_API_KEY=re_xxxxx

# PostgreSQL connection (only change if using external DB)
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ===========================================
# UMAMI ANALYTICS
# ===========================================

# Umami Database Credentials
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=your-secure-umami-db-password
UMAMI_DB_NAME=umami

# Umami Application Secret - Generate a secure key
# Example: openssl rand -base64 32
UMAMI_APP_SECRET=your-secure-umami-secret-key

# Umami Tracker Script Name (optional, default: script.js)
# Change this if you want to avoid ad-blockers
# UMAMI_TRACKER_SCRIPT_NAME=analytics.js
